# Both are optional. With neither set, the app runs fully offline against
# the deterministic FixtureLLMClient (this is the default in tests and CI).
# Set ONE of these to route extraction through a real model instead:

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
